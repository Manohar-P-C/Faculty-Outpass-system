# ============================================================
# Faculty Outpass System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to GitHub.
# ============================================================

# Database Credentials (Aiven Cloud MySQL or local MySQL)
DB_HOST=your-db-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_PORT=3306
DB_SSL=false

# Gmail SMTP Email Credentials
# How to generate a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create a new App Password (name it e.g. "Faculty Outpass")
#   5. Paste the 16-character password below (no spaces)
SENDER_EMAIL=your-gmail@gmail.com
SENDER_PASSWORD=your-16-char-app-password

# Optional: Flask secret key (leave default for local dev)
# SECRET_KEY=your-random-secret-key
